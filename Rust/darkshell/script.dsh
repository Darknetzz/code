# Example Darkshell (.dsh) script. See SPEC.md in this crate for the language sketch.
# Run from the darkshell directory: cargo run -- script.dsh
#
# Tip: end statements with `;` before a line that starts with `name()` so the
# parser does not treat `name()` as extra arguments to the previous command.

export PROJECT=darkshell;

greet() {
  # Use ${#} for argc: bare $# is not recognized by the v0 lexer in all contexts.
  echo "Hello from $PROJECT; argc is ${#}; first arg is $1";
}

echo "pwd says:"; pwd;
greet "dsh user";

if false; then
  echo "not taken";
elif true; then
  echo "elif branch runs";
else
  echo "not taken";
fi

false || echo "|| runs after a failing command";
true && echo "&& runs after success";

for w in one two three; do
  echo "for word: $w";
done

while false; do
  echo "this never prints";
done
echo "while finished";

export TMPVAR=set;
unset TMPVAR;
echo "after unset, TMPVAR is" "'$TMPVAR'";

echo escaped dollar outside quotes: \$PATH;
echo "double-quoted PROJECT:" "$PROJECT";
