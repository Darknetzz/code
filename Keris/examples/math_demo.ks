// Math operations and standard library

let x = 16
let y = 25

print("Square root of", x, ":", math.sqrt(x))
print("Square root of", y, ":", math.sqrt(y))
print("2 to the power of 8:", math.pow(2, 8))
print("Maximum of 1, 5, 3, 9:", math.max(1, 5, 3, 9))
print("Minimum of 1, 5, 3, 9:", math.min(1, 5, 3, 9))
print("Absolute value of -42:", math.abs(-42))
print("Floor of 3.7:", math.floor(3.7))
print("Ceil of 3.2:", math.ceil(3.2))
print("Round of 3.5:", math.round(3.5))
print("Pi:", math.pi)
print("E:", math.e)
